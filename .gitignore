learnings/*.md
!learnings/.gitkeep

# Global patterns content is per-user
global/patterns/*.md
!global/patterns/.gitkeep

# Board app (local only)
board-app/

# Story chronicles (personal)
story/

# Legacy hooks
hooks/

# Dispatches (archived)
dispatches/

# Build artifacts
node_modules/
dist/
.vite/

# Legacy
.board-sync-errors.log
.server.log
crew-dashboard.html
crew-diagram.html

# OS
.DS_Store

# Archive (restorable, not shared)
.archive/
.swarm/
ruvector.db
*.db
*.db-shm
*.db-wal
