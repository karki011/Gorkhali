{
  "name": "gorkhali",
  "version": "1.2.0",
  "description": "Provider-adaptive multi-agent development workflows for Kimi Code.",
  "author": {
    "name": "Subash Karki"
  },
  "homepage": "https://github.com/karki011/Gorkhali",
  "repository": "https://github.com/karki011/Gorkhali",
  "keywords": [
    "orchestration",
    "multi-agent",
    "agents",
    "workflow",
    "learning"
  ],
  "skills": "./skills/",
  "agents": "./agents/",
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "command": "node ./hooks/routing-gate.js",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "command": "node ./hooks/test-file-gate.js",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "node ./hooks/greploop-gate.js",
      "timeout": 15
    }
  ],
  "interface": {
    "displayName": "Gorkhali",
    "shortDescription": "Provider-adaptive software delivery workflows",
    "longDescription": "Plan, implement, investigate, review, verify, pause, resume, and ship software work through capability-adaptive workflows.",
    "developerName": "Subash Karki",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/karki011/Gorkhali",
    "defaultPrompt": [
      "Use Gorkhali to plan and implement this task.",
      "Use Gorkhali to investigate this failure.",
      "Use Gorkhali to review and verify these changes."
    ]
  }
}
