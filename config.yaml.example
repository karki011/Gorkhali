# Phantom Works — User Configuration
# Copy to config.yaml and customize. Generated by setup.sh.

jira:
  project: CP                  # Your Jira project key
  auto_transition: true        # Auto-transition tickets (In Progress → Reviewing)

git:
  protected_branches: [main, master, develop]  # Direct work blocked by feature-branch gate

slack:
  dm_channel: ""               # Your Slack DM channel ID for notifications
  enabled: false

models:
  # Only live key — all other agents inherit the session model
  sage: fable                  # Set to opus if you lack Fable 5 entitlement

integrations:
  atlassian_mcp: false         # Auto-detected by setup.sh
  phantom_ai: false            # Auto-detected by setup.sh
  slack_mcp: false             # Auto-detected by setup.sh
  code_review_graph: false     # Auto-detected by setup.sh
  context_mode: false          # Auto-detected by setup.sh
  claude_flow: false           # Auto-detected by setup.sh
  figma_mcp: false             # Auto-detected by setup.sh
  greptile: false              # Opt-in: automated code review loop

greptile:
  reply_tone: neutral          # neutral | roast — tone of in-thread review replies

learning:
  stale_days: 30               # Flag unvalidated learnings entries older than this
  remove_days: 60              # Remove unvalidated entries older than this
  distill_cap: 50              # Max entries per domain before distillation

preferences:
  auto_draft_pr: true          # Draft PR for non-UI work
  caveman_output: true         # Compressed output mode (saves tokens)
  fun_fact_in_pr: false        # Include fun fact in PR body
