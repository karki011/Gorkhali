{
  "$schema": "Hook registry for Phantom. Consumed by hook-router.js.",
  "hooks": [
    {
      "name": "feature-branch-gate",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "script": "hooks/feature-branch-gate.sh",
      "enabled": true,
      "once": false,
      "priority": 10,
      "input": "arg1-json",
      "description": "Blocks edits on main/master/develop branches"
    },
    {
      "name": "apex-subagent-law",
      "event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "script": "hooks/apex-subagent-driven-law.sh",
      "enabled": true,
      "once": false,
      "priority": 20,
      "input": "stdin-json",
      "description": "Audits/blocks direct Apex edits (subagent enforcement)"
    },
    {
      "name": "pre-phase-context",
      "event": "PreToolUse",
      "matcher": "Agent|Skill",
      "script": "hooks/pre-phase-context.js",
      "enabled": true,
      "once": false,
      "priority": 50,
      "input": "arg2-json",
      "description": "Injects reference content for current session phase"
    },
    {
      "name": "validate-artifact",
      "event": "PostToolUse",
      "matcher": "Write|Edit",
      "script": "hooks/validate-artifact.js",
      "enabled": true,
      "once": false,
      "priority": 30,
      "input": "arg2-json",
      "description": "Validates _meta headers in session artifact JSON"
    },
    {
      "name": "observation-capture",
      "event": "PostToolUse",
      "matcher": "Read|Edit|Write|Bash|Grep|Glob",
      "script": "hooks/observation-capture.js",
      "enabled": true,
      "once": false,
      "priority": 100,
      "input": "arg2-json",
      "description": "Captures structural file observations to NDJSON"
    },
    {
      "name": "memory-consolidator",
      "event": "PreCompact",
      "matcher": ".*",
      "script": "hooks/memory-consolidator.js",
      "enabled": true,
      "once": false,
      "priority": 40,
      "input": "stdin-json",
      "description": "Distills session state to memory-snapshot.json before compaction"
    },
    {
      "name": "context-compact-guide",
      "event": "PreCompact",
      "matcher": ".*",
      "script": "hooks/context-compact-guide.sh",
      "enabled": true,
      "once": false,
      "priority": 50,
      "input": "stdin-json",
      "description": "Outputs compact guidance before context compaction"
    },
    {
      "name": "memory-reader",
      "event": "UserPromptSubmit",
      "matcher": ".*",
      "script": "hooks/memory-reader.js",
      "enabled": true,
      "once": false,
      "priority": 5,
      "input": "stdin-json",
      "description": "Injects relevant learnings from INDEX.md before each prompt"
    },
    {
      "name": "memory-writer",
      "event": "Stop",
      "matcher": ".*",
      "script": "hooks/memory-writer.js",
      "enabled": true,
      "once": false,
      "priority": 90,
      "input": "stdin-json",
      "description": "Extracts learning candidates from this turn's observations"
    }
  ]
}
