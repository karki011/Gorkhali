{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/never-edits.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/role-model-gate.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/never-edits.js\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/never-edits.js\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
