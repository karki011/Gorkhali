{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/aggregation-result-v2.json",
  "title": "Phantom parallel aggregation result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "status",
    "baseline_fingerprint",
    "worktree_fingerprint",
    "integrated_snapshot_digest",
    "integrated_manifest",
    "integration_delta",
    "integration_changed_content_shards",
    "integration_changed_physical_shards",
    "authorized_changed_paths",
    "branches",
    "conflicts",
    "aggregate_verification"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "node_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["accepted", "rejected", "missing_evidence"] },
    "baseline_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "worktree_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "integrated_snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "integrated_manifest": { "type": "object" },
    "integration_delta": { "type": "object" },
    "integration_changed_content_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "before", "after"],
        "properties": {
          "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
          "before": { "type": ["object", "null"] },
          "after": { "type": ["object", "null"] }
        }
      }
    },
    "integration_changed_physical_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "before", "after"],
        "properties": {
          "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
          "before": { "type": ["object", "null"] },
          "after": { "type": ["object", "null"] }
        }
      }
    },
    "authorized_changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "status",
          "run_id",
          "lease_id",
          "start_receipt_digest",
          "completion_receipt_digest",
          "baseline_fingerprint",
          "workspace_identity",
          "baseline_manifest",
          "current_manifest",
          "workspace_delta",
          "changed_content_shards",
          "changed_physical_shards",
          "changed_paths",
          "changed_physical_paths",
          "artifact_refs",
          "artifact_digests",
          "verification",
          "failure_class",
          "cost_units",
          "duration_ms",
          "teardown"
        ],
        "properties": {
          "branch_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "run_id": { "type": "string", "minLength": 1 },
          "lease_id": { "type": "string", "minLength": 1 },
          "start_receipt_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "completion_receipt_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "baseline_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "workspace_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "baseline_manifest": { "type": "object" },
          "current_manifest": { "type": "object" },
          "workspace_delta": { "type": "object" },
          "changed_content_shards": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bucket", "before", "after"],
              "properties": {
                "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
                "before": { "type": ["object", "null"] },
                "after": { "type": ["object", "null"] }
              }
            }
          },
          "changed_physical_shards": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bucket", "before", "after"],
              "properties": {
                "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
                "before": { "type": ["object", "null"] },
                "after": { "type": ["object", "null"] }
              }
            }
          },
          "changed_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "changed_physical_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "artifact_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "artifact_digests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_ref", "digest"],
              "properties": {
                "artifact_ref": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "result"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "result": { "enum": ["passed", "failed"] }
              }
            }
          },
          "failure_class": { "type": ["string", "null"] },
          "cost_units": { "type": "number", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "teardown": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_lease_revoked",
              "process_tree_reaped",
              "descendants_remaining",
              "mounts_removed",
              "sandbox_destroyed"
            ],
            "properties": {
              "tool_lease_revoked": { "const": true },
              "process_tree_reaped": { "const": true },
              "descendants_remaining": { "const": 0 },
              "mounts_removed": { "const": true },
              "sandbox_destroyed": { "const": true }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "aggregate_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "snapshot_digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed"] },
          "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
