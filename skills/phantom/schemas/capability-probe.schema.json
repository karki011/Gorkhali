{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/capability-probe-v1.json",
  "title": "Phantom native tool interception probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_kind",
    "repo_id",
    "task_id",
    "worktree_fingerprint",
    "adapter_binding",
    "capabilities",
    "hooks",
    "host",
    "issued_at",
    "expires_at",
    "source",
    "source_event_id",
    "replay_id",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "probe_kind": { "const": "native-tool-interception" },
    "repo_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "worktree_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapter_binding": { "const": "native-tool-gate-v1" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle.hooks"],
      "properties": {
        "lifecycle.hooks": { "const": "available" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_tool_use", "post_tool_use"],
      "properties": {
        "pre_tool_use": { "const": "enforced" },
        "post_tool_use": { "const": "enforced" }
      }
    },
    "host": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_event_id": { "type": "string", "minLength": 1 },
    "replay_id": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
