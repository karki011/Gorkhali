{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/host-adapter-registration-v1.json",
  "title": "Phantom host adapter registration",
  "description": "A short-lived registry-signed certificate for one host-owned adapter. It contains public identity and policy only, never executable locations or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_kind",
    "registration_id",
    "adapter",
    "scope",
    "capabilities",
    "issued_at",
    "expires_at",
    "source",
    "source_event_id",
    "replay_id",
    "registry_key_id",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registration_kind": { "const": "host-adapter" },
    "registration_id": { "$ref": "#/$defs/identifier" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "host_instance_id",
        "attestation_key_id",
        "attestation_public_key"
      ],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/identifier" },
        "adapter_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 128
        },
        "host_instance_id": { "$ref": "#/$defs/identifier" },
        "attestation_key_id": { "$ref": "#/$defs/identifier" },
        "attestation_public_key": { "type": "string", "minLength": 32, "maxLength": 8192 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "task_id"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/processCapability" },
          { "$ref": "#/$defs/gitCommitCapability" },
          { "$ref": "#/$defs/gitPushCapability" },
          { "$ref": "#/$defs/githubCapability" },
          { "$ref": "#/$defs/trackerCapability" }
        ]
      }
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "source": { "$ref": "#/$defs/identifier" },
    "source_event_id": { "$ref": "#/$defs/identifier" },
    "replay_id": { "$ref": "#/$defs/identifier" },
    "registry_key_id": { "$ref": "#/$defs/identifier" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "processCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "policy"],
      "properties": {
        "type": { "const": "process.exec" },
        "contract": { "const": "sandbox-exec-v1" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shell",
            "stdin",
            "network",
            "filesystem",
            "repository_control",
            "phantom_control",
            "environment",
            "credentials",
            "allowed_environment_names",
            "process_tree",
            "max_duration_ms",
            "max_output_bytes",
            "max_processes"
          ],
          "properties": {
            "shell": { "const": "disabled" },
            "stdin": { "const": "closed" },
            "network": { "const": "denied" },
            "filesystem": { "const": "request-scoped" },
            "repository_control": { "const": "inaccessible" },
            "phantom_control": { "const": "inaccessible" },
            "environment": { "const": "allowlist-only" },
            "credentials": { "const": "absent" },
            "allowed_environment_names": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/environmentName" }
            },
            "process_tree": { "const": "terminate-on-timeout" },
            "max_duration_ms": { "type": "integer", "minimum": 1, "maximum": 900000 },
            "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "max_processes": { "type": "integer", "minimum": 1, "maximum": 256 }
          }
        }
      }
    },
    "gitCommitCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "policy"],
      "properties": {
        "type": { "const": "git.commit" },
        "contract": { "const": "git-commit-v1" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hooks", "signing", "allow_empty"],
          "properties": {
            "hooks": { "const": "disabled" },
            "signing": { "const": "disabled" },
            "allow_empty": { "const": false }
          }
        }
      }
    },
    "gitPushCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "target", "policy"],
      "properties": {
        "type": { "const": "git.push" },
        "contract": { "const": "git-push-v1" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remote", "repository_id", "allowed_branches"],
          "properties": {
            "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "repository_id": { "$ref": "#/$defs/identifier" },
            "allowed_branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["force", "delete", "tags"],
          "properties": {
            "force": { "const": "denied" },
            "delete": { "const": "denied" },
            "tags": { "const": "denied" }
          }
        }
      }
    },
    "githubCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "target"],
      "properties": {
        "type": { "const": "github.openDraftPr" },
        "contract": { "const": "github-draft-pr-v1" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "repository_id", "allowed_base_refs", "draft_only"],
          "properties": {
            "host": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 253 },
            "repository_id": { "$ref": "#/$defs/identifier" },
            "allowed_base_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "draft_only": { "const": true }
          }
        }
      }
    },
    "trackerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "target"],
      "properties": {
        "type": { "const": "tracker.comment" },
        "contract": { "const": "tracker-comment-v1" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "tenant_id", "project_id"],
          "properties": {
            "provider": { "enum": ["jira", "linear", "github"] },
            "tenant_id": { "$ref": "#/$defs/identifier" },
            "project_id": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  }
}
