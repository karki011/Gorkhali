{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/host-adapter-registry-trust-v1.json",
  "title": "Phantom host adapter registry trust",
  "description": "A locally configured, versioned trust root for host-adapter registration only. It is not lifecycle authority and contains no executable location or credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_kind",
    "trust_id",
    "key_id",
    "source",
    "algorithm",
    "public_key",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "trust_kind": { "const": "host-adapter-registry" },
    "trust_id": { "$ref": "#/$defs/identifier" },
    "key_id": { "$ref": "#/$defs/identifier" },
    "source": { "$ref": "#/$defs/identifier" },
    "algorithm": { "const": "ed25519" },
    "public_key": {
      "type": "string",
      "minLength": 32,
      "maxLength": 8192
    },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
