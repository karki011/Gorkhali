{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/isolated-executor-probe-v1.json",
  "title": "Phantom isolated executor probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_kind",
    "executor_id",
    "contract_version",
    "repo_id",
    "task_id",
    "worktree_fingerprint",
    "isolation_profile",
    "self_test",
    "issued_at",
    "expires_at",
    "source",
    "source_event_id",
    "replay_id",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "probe_kind": { "const": "isolated-branch-executor" },
    "executor_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "contract_version": { "const": "isolated-branch-executor-v1" },
    "repo_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "worktree_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "isolation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "platform",
        "backend",
        "backend_digest",
        "filesystem",
        "process",
        "tool_plane",
        "artifact_egress",
        "network"
      ],
      "properties": {
        "profile_id": { "const": "continuous-isolation-v1" },
        "platform": { "enum": ["linux", "darwin"] },
        "backend": { "type": "string", "minLength": 1 },
        "backend_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "filesystem": { "const": "private-root-no-host-writes" },
        "process": { "const": "contained-and-reaped" },
        "tool_plane": { "const": "lease-scoped" },
        "artifact_egress": { "const": "digest-bound" },
        "network": { "enum": ["denied", "mediated-model-proxy"] }
      }
    },
    "self_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at", "evidence_digest"],
      "properties": {
        "status": { "const": "passed" },
        "observed_at": { "type": "string", "minLength": 1 },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "issued_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "replay_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
