{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/workflow-event-v1.json",
  "title": "Phantom workflow event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "workflow_id",
    "event_type",
    "node_id",
    "recorded_at",
    "previous_event_digest",
    "payload_digest",
    "event_digest",
    "artifact_refs",
    "worktree_fingerprint",
    "producer",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "workflow_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "event_type": {
      "enum": [
        "workflow.started",
        "node.started",
        "node.completed",
        "node.failed",
        "node.invalidated",
        "worktree.changed",
        "parallel.branch.started",
        "parallel.branch.completed",
        "parallel.branch.retry_requested",
        "parallel.aggregated",
        "evaluation.recorded",
        "budget.exhausted",
        "capability.decision",
        "capability.outcome"
      ]
    },
    "node_id": { "type": ["string", "null"] },
    "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "previous_event_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "event_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "worktree_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" }
  }
}
