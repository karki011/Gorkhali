{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/workflow-plan-v2.json",
  "title": "Phantom workflow plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "route",
    "risk",
    "baseline_fingerprint",
    "session_binding",
    "routing",
    "execution_mode",
    "acceptance_criteria",
    "budget",
    "nodes"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "workflow_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "route": { "enum": ["direct", "plan", "brainstorm", "full"] },
    "risk": { "enum": ["low", "moderate", "high", "critical"] },
    "baseline_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "executor_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_content_manifest_digest",
        "baseline_fingerprint",
        "baseline_physical_topology_root",
        "contract_version",
        "executor_id",
        "isolation_profile",
        "key_id",
        "probe_digest",
        "profile_digest",
        "public_key",
        "public_key_digest",
        "source",
        "trust_activated_at",
        "trust_digest",
        "trust_expires_at",
        "trust_generation",
        "trust_replaces_key_id"
      ],
      "properties": {
        "baseline_content_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "baseline_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "baseline_physical_topology_root": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contract_version": { "const": "isolated-branch-executor-v1" },
        "executor_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "isolation_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "platform",
            "backend",
            "backend_digest",
            "filesystem",
            "process",
            "tool_plane",
            "artifact_egress",
            "network"
          ],
          "properties": {
            "profile_id": { "const": "continuous-isolation-v1" },
            "platform": { "enum": ["linux", "darwin"] },
            "backend": { "type": "string", "minLength": 1 },
            "backend_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "filesystem": { "const": "private-root-no-host-writes" },
            "process": { "const": "contained-and-reaped" },
            "tool_plane": { "const": "lease-scoped" },
            "artifact_egress": { "const": "digest-bound" },
            "network": { "enum": ["denied", "mediated-model-proxy"] }
          }
        },
        "key_id": { "type": "string", "minLength": 1 },
        "probe_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "profile_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "public_key": { "type": "string", "minLength": 1 },
        "public_key_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$" },
        "trust_activated_at": { "type": "string", "minLength": 1 },
        "trust_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "trust_expires_at": { "type": "string", "minLength": 1 },
        "trust_generation": { "type": "integer", "minimum": 1 },
        "trust_replaces_key_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "task_id", "route", "approved_plan"],
      "properties": {
        "repo_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "route": { "enum": ["direct", "plan", "brainstorm", "full"] },
        "approved_plan": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["artifact_type", "record_sequence", "digest"],
          "properties": {
            "artifact_type": { "const": "plan" },
            "record_sequence": { "type": "integer", "minimum": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_route", "confidence", "fallback_route", "signals"],
      "properties": {
        "recommended_route": { "enum": ["direct", "plan", "brainstorm", "full"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fallback_route": { "enum": [null, "plan", "brainstorm", "full"] },
        "signals": { "type": "object" }
      }
    },
    "execution_mode": { "enum": ["attended", "unattended"] },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost_units", "max_duration_ms", "max_attempts"],
      "properties": {
        "max_cost_units": { "type": "number", "minimum": 0 },
        "max_duration_ms": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "depends_on", "retry_limit", "budget"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "kind": { "enum": ["task", "parallel", "aggregate", "evaluate-optimize", "external-action"] },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          },
          "retry_limit": { "type": "integer", "minimum": 0, "maximum": 20 },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_cost_units": { "type": "number", "minimum": 0 },
              "max_duration_ms": { "type": "integer", "minimum": 0 },
              "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
              "stuck_failure_limit": { "type": "integer", "minimum": 2, "maximum": 10 }
            }
          },
          "role": { "enum": ["apex", "blade", "ward", "sweep", "gaze", "hound", "rival", "plan-checker"] },
          "output_schema": {
            "enum": ["workflow-output-v1", "aggregation-result-v2", "evaluation-result-v1"]
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_commands": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "allowed_cwds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "expected_artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" }
          },
          "dependency_evidence": { "enum": ["complete", "partial", "unknown"] },
          "branches": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "role",
                "baseline_fingerprint",
                "dependency_inputs",
                "allowed_paths",
                "expected_artifacts",
                "verification",
                "budget",
                "retry_limit"
              ],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
                "role": { "enum": ["blade", "ward", "sweep", "gaze", "hound", "rival", "plan-checker"] },
                "baseline_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "dependency_inputs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source_node", "artifact_ref", "digest"],
                    "properties": {
                      "source_node": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
                      "artifact_ref": { "type": "string", "minLength": 1 },
                      "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
                    }
                  }
                },
                "allowed_paths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "expected_artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "verification": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" }
                },
                "budget": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["max_cost_units", "max_duration_ms"],
                  "properties": {
                    "max_cost_units": { "type": "number", "minimum": 0 },
                    "max_duration_ms": { "type": "integer", "minimum": 0 }
                  }
                },
                "retry_limit": { "type": "integer", "minimum": 0, "maximum": 20 }
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "generator_role": { "enum": ["apex", "blade", "ward", "sweep", "gaze", "hound", "rival", "plan-checker"] },
          "evaluator_role": { "enum": ["apex", "blade", "ward", "sweep", "gaze", "hound", "rival", "plan-checker"] },
          "action": { "enum": ["draft-pr", "git-push", "tracker-comment"] },
          "idempotency_key": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
