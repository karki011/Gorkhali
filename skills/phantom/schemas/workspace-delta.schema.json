{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/workspace-delta-v2.json",
  "title": "Phantom workspace manifest delta v2",
  "description": "Compact deterministic difference between two workspace manifests. Author: Subash Karki.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "from",
    "to",
    "changed_paths",
    "changed_physical_paths",
    "changed_content_shards",
    "changed_physical_shards",
    "delta_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "algorithm": { "const": "phantom-workspace-delta-v2" },
    "from": { "$ref": "#/$defs/evidenceReference" },
    "to": { "$ref": "#/$defs/evidenceReference" },
    "changed_paths": { "$ref": "#/$defs/pathList" },
    "changed_physical_paths": { "$ref": "#/$defs/pathList" },
    "changed_content_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changedShard" }
    },
    "changed_physical_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changedShard" }
    },
    "delta_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/portablePath" }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "fingerprint",
        "policy_digest",
        "snapshot_digest",
        "manifest_digest",
        "evidence_digest",
        "physical_root",
        "physical_topology_root"
      ],
      "properties": {
        "algorithm": { "const": "phantom-workspace-merkle-v2" },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "evidence_digest": { "$ref": "#/$defs/digest" },
        "physical_root": { "$ref": "#/$defs/digest" },
        "physical_topology_root": { "$ref": "#/$defs/digest" }
      }
    },
    "changedShard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "before_digest", "after_digest"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
        "before_digest": { "$ref": "#/$defs/nullableDigest" },
        "after_digest": { "$ref": "#/$defs/nullableDigest" }
      }
    }
  }
}
