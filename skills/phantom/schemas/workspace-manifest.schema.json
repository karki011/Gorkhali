{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schemas/workspace-manifest-v2.json",
  "title": "Phantom workspace manifest evidence v2",
  "description": "Compact content-addressed workspace evidence. Author: Subash Karki.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "policy_digest",
    "snapshot_digest",
    "content_root",
    "entry_count",
    "regular_file_count",
    "symbolic_link_count",
    "content_shards",
    "policy",
    "fingerprint",
    "manifest_digest",
    "physical_root",
    "physical_topology_root",
    "physical_shards",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "algorithm": { "const": "phantom-workspace-merkle-v2" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "snapshot_digest": { "$ref": "#/$defs/digest" },
    "content_root": { "$ref": "#/$defs/digest" },
    "entry_count": { "type": "integer", "minimum": 0 },
    "regular_file_count": { "type": "integer", "minimum": 0 },
    "symbolic_link_count": { "type": "integer", "minimum": 0 },
    "content_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contentShardReference" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "tracked",
        "untracked",
        "ignored",
        "control_exclusions",
        "special_files"
      ],
      "properties": {
        "policy_id": { "const": "portable-all-files-v2" },
        "tracked": { "const": "include" },
        "untracked": { "const": "include" },
        "ignored": { "const": "include" },
        "control_exclusions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            { "const": ".git" },
            { "const": ".phantom" }
          ]
        },
        "special_files": { "const": "reject" }
      }
    },
    "fingerprint": { "$ref": "#/$defs/digest" },
    "manifest_digest": { "$ref": "#/$defs/digest" },
    "physical_root": { "$ref": "#/$defs/digest" },
    "physical_topology_root": { "$ref": "#/$defs/digest" },
    "physical_shards": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/physicalShardReference" }
    },
    "evidence_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contentShardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "digest", "entry_count"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "entry_count": { "type": "integer", "minimum": 1 }
      }
    },
    "physicalShardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "digest", "entry_count", "topology_digest"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-f0-9]{2}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "entry_count": { "type": "integer", "minimum": 1 },
        "topology_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
